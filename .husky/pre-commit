#!/usr/bin/env sh

# 1) Prettier + ESLint (with unused-imports) on staged files only
npm run lint-staged || exit 1

# 2) Full TypeScript type-check
npm run typecheck || exit 1

# 3) Development build (Vite build here, equivalent to Next.js build gate)
npm run build:dev || exit 1

 # 3) Production build (Vite build here, equivalent to Next.js build gate)
npm run build || exit 1